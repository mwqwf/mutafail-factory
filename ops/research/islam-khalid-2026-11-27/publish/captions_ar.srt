1
00:00:00,000 --> 00:00:04,438
عَلَى خَيْلِ الْمُشْرِكِينَ كَانَ خَالِدُ بْنُ الْوَلِيدِ…

2
00:00:04,724 --> 00:00:07,552
وَالْمُسْلِمُونَ أَمَامَهُ يُصَلُّونَ،

3
00:00:07,838 --> 00:00:09,657
فَقَالَ الْمُشْرِكُونَ:

4
00:00:09,943 --> 00:00:12,057
لَقَدْ أَصَبْنَا غِرَّةً… لَقَدْ

5
00:00:12,343 --> 00:00:14,305
أَصَبْنَا غَفْلَةً! لَوْ كُنَّا

6
00:00:14,590 --> 00:00:17,819
حَمَلْنَا عَلَيْهِمْ وَهُمْ فِي الصَّلَاةِ!

7
00:00:18,105 --> 00:00:19,400
فِي عُسْفَانَ، بَيْنَ

8
00:00:19,686 --> 00:00:21,295
الظُّهْرِ وَالْعَصْرِ،

9
00:00:21,581 --> 00:00:24,409
نَزَلَتْ آيَةُ صَلَاةِ الْخَوْفِ.

10
00:00:24,695 --> 00:00:26,571
فَلَمَّا حَضَرَتِ الْعَصْرُ،

11
00:00:26,857 --> 00:00:29,514
وَقَفَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ

12
00:00:29,800 --> 00:00:31,248
وَسَلَّمَ مُسْتَقْبِلَ

13
00:00:31,533 --> 00:00:33,200
الْقِبْلَةِ وَالْمُشْرِكُونَ

14
00:00:33,486 --> 00:00:35,181
أَمَامَهُ، وَصَلَّى

15
00:00:35,467 --> 00:00:37,152
بِأَصْحَابِهِ: صَفٌّ يُصَلِّي

16
00:00:37,438 --> 00:00:39,362
مَعَهُ، وَصَفٌّ يَحْرُسُهُمْ.

17
00:00:39,647 --> 00:00:42,781
هَذِهِ قِصَّةُ إِسْلَامِ خَالِدْ.

18
00:00:43,067 --> 00:00:48,609
فَهَلْ حَمَلَ خَالِدٌ؟ وَكَيْفَ صَارَ سَيْفًا مِنْ سُيُوفِ اللَّهِ؟

19
00:00:48,895 --> 00:00:51,571
وَقَالَ خَالِدٌ فِي نَفْسِهِ:

20
00:00:51,857 --> 00:00:54,038
الرَّجُلُ مَمْنُوعْ.

21
00:00:54,324 --> 00:00:57,067
وَكَانَ يُحَدِّثُ نَفْسَهُ مِنْ قَبْلُ:

22
00:00:57,352 --> 00:01:01,171
قَدْ شَهِدْتُ هَذِهِ الْمَوَاطِنَ كُلَّهَا عَلَى

23
00:01:01,457 --> 00:01:04,743
مُحَمَّدٍ، وَمَا مِنْ مَوْطِنٍ شَهِدْتُهُ إِلَّا

24
00:01:05,028 --> 00:01:09,152
انْصَرَفْتُ وَأَنَا أَرَى فِي نَفْسِي أَنِّي مُوضِعٌ فِي

25
00:01:09,438 --> 00:01:12,371
غَيْرِ شَيْءٍ، وَأَنَّ مُحَمَّدًا سَيَظْهَرْ.

26
00:01:12,657 --> 00:01:16,609
وَفِي أُحُدٍ كَانَ عَلَى مَيْمَنَةِ خَيْلِ قُرَيْشْ.

27
00:01:16,895 --> 00:01:21,638
وَمِنْ مَوْضِعِ الرُّمَاةِ دَخَلَتْ خَيْلُهُ، فَالْتَبَسَتِ الصُّفُوفُ.

28
00:01:21,924 --> 00:01:27,676
وَفِي طَرِيقِ الْحُدَيْبِيَةِ قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ لِأَصْحَابِهِ:

29
00:01:27,962 --> 00:01:32,809
إِنَّ خَالِدَ بْنَ الْوَلِيدِ بِالْغَمِيمِ فِي خَيْلٍ لِقُرَيْشٍ طَلِيعَةٌ،

30
00:01:33,095 --> 00:01:35,314
فَخُذُوا ذَاتَ الْيَمِينِ.

31
00:01:35,600 --> 00:01:39,467
وَمَا شَعَرَ بِهِمْ خَالِدٌ حَتَّى رَأَى غُبَارَ الْجَيْشِ،

32
00:01:39,752 --> 00:01:42,819
فَانْطَلَقَ يَرْكُضُ نَذِيرًا لِقُرَيْشْ.

33
00:01:43,105 --> 00:01:47,990
وَانْتَهَتِ الْحُدَيْبِيَةُ بِصُلْحٍ. وَقَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ

34
00:01:48,276 --> 00:01:55,924
وَسَلَّمَ: وَالَّذِي نَفْسِي بِيَدِهِ، لَا يَسْأَلُونِي خُطَّةً يُعَظِّمُونَ فِيهَا حُرُمَاتِ اللَّهِ إِلَّا أَعْطَيْتُهُمْ إِيَّاهَا.

35
00:01:56,209 --> 00:01:59,362
وَبَعْدَ الصُّلْحِ، سَأَلَ خَالِدٌ نَفْسَهُ:

36
00:01:59,647 --> 00:02:04,809
أَيُّ شَيْءٍ بَقِيَ؟ أَيْنَ الْمَذْهَبُ؟ إِلَى النَّجَاشِيِّ؟ فَقَدِ

37
00:02:05,095 --> 00:02:09,276
اتَّبَعَ مُحَمَّدًا، وَأَصْحَابُهُ عِنْدَهُ آمِنُونَ. إِلَى

38
00:02:09,562 --> 00:02:14,409
هِرَقْلَ؟ فَأَخْرُجُ مِنْ دِينِي إِلَى نَصْرَانِيَّةٍ أَوْ يَهُودِيَّةٍ،

39
00:02:14,695 --> 00:02:20,047
وَأُقِيمُ فِي عَجَمٍ تَابِعًا؟ أَمْ أُقِيمُ فِي دَارِي فِيمَنْ بَقِيَ؟

40
00:02:20,333 --> 00:02:25,590
ثُمَّ دَخَلَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ مَكَّةَ فِي عُمْرَةِ الْقَضَاءِ،

41
00:02:25,876 --> 00:02:29,038
وَتَغَيَّبَ خَالِدٌ فَلَمْ يَشْهَدْ دُخُولَهُ.

42
00:02:29,324 --> 00:02:33,933
وَكَانَ أَخُوهُ الْوَلِيدُ بْنُ الْوَلِيدِ قَدْ أَسْلَمَ، فَكَتَبَ إِلَيْهِ:

43
00:02:34,219 --> 00:02:40,181
لَمْ أَرَ أَعْجَبَ مِنْ ذَهَابِ رَأْيِكَ عَنِ الْإِسْلَامِ! وَعَقْلُكَ

44
00:02:40,467 --> 00:02:46,238
عَقْلُكَ! وَقَدْ سَأَلَنِي النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْكَ،

45
00:02:46,524 --> 00:02:51,200
وَقَالَ: أَيْنَ خَالِدٌ؟ فَقُلْتُ: يَأْتِي اللَّهُ بِهِ.

46
00:02:51,486 --> 00:02:55,943
فَقَالَ: مَا مِثْلُهُ جَهِلَ الْإِسْلَامَ! وَلَوْ جَعَلَ

47
00:02:56,228 --> 00:03:00,171
نِكَايَتَهُ وَحْدَهُ مَعَ الْمُسْلِمِينَ، لَكَانَ

48
00:03:00,457 --> 00:03:05,276
خَيْرًا لَهُ، وَلَقَدَّمْنَاهُ عَلَى غَيْرِهِ. فَاسْتَدْرِكْ

49
00:03:05,562 --> 00:03:12,038
يَا أَخِي مَا فَاتَكَ، فَقَدْ فَاتَكَ الصَّالِحُ مِنَ الْمَوَاطِنِ.

50
00:03:12,324 --> 00:03:14,971
وَقَالَ خَالِدٌ بَعْدَ ذَلِكَ:

51
00:03:15,257 --> 00:03:19,752
فَلَمَّا جَاءَنِي كِتَابُهُ نَشِطْتُ لِلْخُرُوجِ،

52
00:03:20,038 --> 00:03:25,819
وَسَرَّنِي سُؤَالُ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنِّي.

53
00:03:26,105 --> 00:03:30,600
وَلَقِيَ خَالِدٌ عُثْمَانَ بْنَ طَلْحَةَ، وَكَانَ صَدِيقًا لَهُ،

54
00:03:30,885 --> 00:03:33,866
فَذَكَرَ لَهُ مَا يَنْوِيهِ، وَقَالَ:

55
00:03:34,152 --> 00:03:37,495
إِنَّمَا نَحْنُ بِمَنْزِلَةِ ثَعْلَبٍ فِي جُحْرٍ،

56
00:03:37,781 --> 00:03:41,400
لَوْ صُبَّ فِيهِ ذَنُوبٌ مِنْ مَاءٍ لَخَرَجَ.

57
00:03:41,685 --> 00:03:46,438
فَهَلْ يُجِيبُهُ عُثْمَانُ، وَأَبُوهُ قَتِيلُ أُحُدْ؟

58
00:03:46,724 --> 00:03:49,543
فَأَسْرَعَ عُثْمَانُ إِلَى الْإِجَابَةِ،

59
00:03:49,828 --> 00:03:52,276
وَقَالَ: هَذِهِ رَاحِلَتِي بِفَخٍّ مُنَاخَةٌ.

60
00:03:52,562 --> 00:03:56,790
وَاتَّفَقَا عَلَى مَوْعِدٍ قَبْلَ الْفَجْرِ فِي مَكَانٍ يُسَمَّى يَأْجَجَ،

61
00:03:57,076 --> 00:03:59,438
وَخَرَجَا مُتَّجِهَيْنِ إِلَى الْمَدِينَةِ.

62
00:03:59,724 --> 00:04:06,238
وَقَبْلَ أَنْ نُكْمِلَ مَعَهُمَا الطَّرِيقَ: إِنْ أَرَدْتَ أَنْ تَعْرِفَ مَاذَا فَعَلَ خَالِدٌ بِسَيْفِهِ بَعْدَ أَنْ

63
00:04:06,524 --> 00:04:11,743
أَسْلَمَ، فَفِي الْبِطَاقَةِ الَّتِي تَظْهَرُ الْآنَ قِصَّةُ يَوْمٍ نَادَاهُ فِيهِ هُرْمُزُ بِاسْمِهِ.

64
00:04:12,028 --> 00:04:14,952
شَاهِدْهَا بَعْدَ أَنْ تُكْمِلَ هَذِهِ الْقِصَّةَ.

65
00:04:15,238 --> 00:04:19,276
لَكِنَّ رَجُلًا ثَالِثًا كَانَ عَلَى الطَّرِيقِ نَفْسِهِ.

66
00:04:19,562 --> 00:04:24,276
وَكَانَ عَمْرُو بْنُ الْعَاصِ قَدْ سَبَقَهُمَا بِقِصَّةٍ عَجِيبَةٍ فِي

67
00:04:24,562 --> 00:04:27,971
الْحَبَشَةِ: جَاءَ النَّجَاشِيَّ بِهَدِيَّةٍ مِنَ الْأُدُمِ

68
00:04:28,257 --> 00:04:34,895
فَسَرَّتْهُ، فَلَمَّا رَأَى طِيبَ نَفْسِهِ سَأَلَهُ أَنْ يُعْطِيَهُ رَسُولَ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ

69
00:04:35,181 --> 00:04:40,371
لِيَقْتُلَهُ، فَغَضِبَ النَّجَاشِيُّ وَضَرَبَ أَنْفَهُ ضَرْبَةً ظَنَّ عَمْرٌو أَنَّهَا كَسَرَتْهُ،

70
00:04:40,657 --> 00:04:44,809
وَجَعَلَ يَتَلَقَّى الدَّمَ بِثِيَابِهِ. ثُمَّ قَالَ لَهُ النَّجَاشِيُّ:

71
00:04:45,095 --> 00:04:50,781
يَا عَمْرُو، تَسْأَلُنِي أَنْ أُعْطِيَكَ رَسُولَ مَنْ يَأْتِيهِ النَّامُوسُ الْأَكْبَرُ،

72
00:04:51,066 --> 00:04:55,105
الَّذِي كَانَ يَأْتِي مُوسَى وَعِيسَى، لِتَقْتُلَهُ؟!

73
00:04:55,390 --> 00:05:02,324
قَالَ عَمْرٌو: فَغَيَّرَ اللَّهُ قَلْبِي عَمَّا كُنْتُ عَلَيْهِ. وَقَالَ لَهُ النَّجَاشِيُّ:

74
00:05:02,609 --> 00:05:07,533
فَأَطِعْنِي وَاتَّبِعْهُ، فَوَاللَّهِ إِنَّهُ لَعَلَى الْحَقِّ.

75
00:05:07,819 --> 00:05:12,781
فَبَايَعَهُ عَمْرٌو عَلَى الْإِسْلَامِ، وَكَتَمَ إِسْلَامَهُ عَنْ أَصْحَابِهِ، ثُمَّ

76
00:05:13,066 --> 00:05:18,943
خَرَجَ يُرِيدُ الْمَدِينَةَ لِيُسْلِمَ بَيْنَ يَدَيِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ.

77
00:05:19,228 --> 00:05:25,352
وَفِي الطَّرِيقِ لَقِيَ خَالِدًا، وَهُوَ مُقْبِلٌ مِنْ مَكَّةَ، فَسَأَلَهُ:

78
00:05:25,638 --> 00:05:28,047
أَيْنَ يَا أَبَا سُلَيْمَانَ؟

79
00:05:28,333 --> 00:05:33,162
وَاللَّهِ لَقَدِ اسْتَقَامَ الْمَنْسِمُ، وَإِنَّ الرَّجُلَ لَنَبِيٌّ!

80
00:05:33,447 --> 00:05:37,124
أَذْهَبُ وَاللَّهِ أُسْلِمُ… فَحَتَّى مَتَى؟

81
00:05:37,409 --> 00:05:40,657
أَيْ: قَدْ تَبَيَّنَ الطَّرِيقُ. فَقَالَ عَمْرٌو:

82
00:05:40,943 --> 00:05:44,085
وَاللَّهِ مَا جِئْتُ إِلَّا لِأُسْلِمَ.

83
00:05:44,371 --> 00:05:48,676
إِنْ أَعْجَبَتْكَ الْقِصَّةُ، فَاشْتَرِكْ وَفَعِّلِ الْجَرَسَ.

84
00:05:48,962 --> 00:05:53,247
وَقَدِمُوا الْمَدِينَةَ فِي صَفَرٍ مِنْ سَنَةِ

85
00:05:53,533 --> 00:05:56,904
ثَمَانٍ. وَلَبِسَ خَالِدٌ مِنْ صَالِحِ

86
00:05:57,190 --> 00:06:00,600
ثِيَابِهِ، وَلَقِيَهُ أَخُوهُ فَقَالَ لَهُ:

87
00:06:00,885 --> 00:06:11,095
أَسْرِعْ، فَإِنَّ رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَدْ أُخْبِرَ بِكَ فَسُرَّ بِقُدُومِكَ، وَهُوَ يَنْتَظِرُكُمْ.

88
00:06:11,381 --> 00:06:15,104
لَكِنْ… بِأَيِّ وَجْهٍ يَلْقَاهُ؟

89
00:06:15,390 --> 00:06:19,628
فَأَسْلَمَ خَالِدُ بْنُ الْوَلِيدِ وَبَايَعَ.

90
00:06:19,914 --> 00:06:23,400
وَيَصِفُ خَالِدٌ تِلْكَ اللَّحْظَةَ:

91
00:06:23,685 --> 00:06:29,876
فَأَسْرَعْنَا الْمَشْيَ، فَمَا زَالَ يَتَبَسَّمُ إِلَيَّ حَتَّى وَقَفْتُ عَلَيْهِ،

92
00:06:30,162 --> 00:06:34,409
فَقُلْتُ: إِنِّي أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللَّهُ،

93
00:06:34,695 --> 00:06:37,162
وَأَنَّكَ رَسُولُ اللَّهِ.

94
00:06:37,447 --> 00:06:41,104
فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ

95
00:06:41,390 --> 00:06:47,352
وَسَلَّمَ: الْحَمْدُ لِلَّهِ الَّذِي هَدَاكَ. قَدْ كُنْتُ أَرَى لَكَ عَقْلًا،

96
00:06:47,638 --> 00:06:51,266
رَجَوْتُ أَلَّا يُسْلِمَكَ إِلَّا إِلَى خَيْرْ.

97
00:06:51,552 --> 00:06:54,923
فَهَلْ يُمْحَى مَاضٍ كَهَذَا؟

98
00:06:55,209 --> 00:07:06,152
يَا رَسُولَ اللَّهِ، قَدْ رَأَيْتَ مَا كُنْتُ أَشْهَدُ مِنْ تِلْكَ الْمَوَاطِنِ عَلَيْكَ مُعَانِدًا لِلْحَقِّ، فَادْعُ اللَّهَ أَنْ يَغْفِرَهَا لِي.

99
00:07:06,438 --> 00:07:10,762
فَقَالَ: الْإِسْلَامُ يَجُبُّ مَا كَانَ قَبْلَهُ.

100
00:07:11,047 --> 00:07:16,028
ثُمَّ قَالَ: اللَّهُمَّ اغْفِرْ لِخَالِدِ بْنِ الْوَلِيدِ

101
00:07:16,314 --> 00:07:20,466
كُلَّ مَا أَوْضَعَ فِيهِ مِنْ صَدٍّ عَنْ سَبِيلِكَ.

102
00:07:20,752 --> 00:07:25,095
وَتَقَدَّمَ بَعْدَهُ عُثْمَانُ بْنُ طَلْحَةَ فَبَايَعَ.

103
00:07:25,381 --> 00:07:29,114
ثُمَّ دَنَا عَمْرُو بْنُ الْعَاصِ، فَقَالَ:

104
00:07:29,400 --> 00:07:37,190
يَا رَسُولَ اللَّهِ، إِنِّي أُبَايِعُكَ عَلَى أَنْ تَغْفِرَ لِي مَا تَقَدَّمَ مِنْ ذَنْبِي.

105
00:07:37,476 --> 00:07:43,219
فَقَالَ لَهُ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ: يَا عَمْرُو،

106
00:07:43,504 --> 00:07:48,752
بَايِعْ، فَإِنَّ الْإِسْلَامَ يَجُبُّ مَا كَانَ قَبْلَهُ،

107
00:07:49,038 --> 00:07:53,085
وَإِنَّ الْهِجْرَةَ تَجُبُّ مَا كَانَ قَبْلَهَا.

108
00:07:53,371 --> 00:07:56,914
فَمَاذَا صَنَعَ خَالِدٌ بَعْدَ إِسْلَامِهِ؟

109
00:07:57,200 --> 00:08:00,133
وَيَقُولُ خَالِدٌ بَعْدَ ذَلِكَ:

110
00:08:00,419 --> 00:08:11,981
فَوَاللَّهِ مَا كَانَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ يَعْدِلُ بِي أَحَدًا مِنْ أَصْحَابِهِ فِيمَا حَزَبَهُ.

111
00:08:12,266 --> 00:08:15,152
وَيَقُولُ خَالِدٌ عَنْ يَوْمِ عُسْفَانَ:

112
00:08:15,438 --> 00:08:18,028
فَهَمَمْنَا أَنْ نُغِيرَ عَلَيْهِمْ،

113
00:08:18,314 --> 00:08:22,581
ثُمَّ لَمْ يُعْزَمْ لَنَا، وَكَانَتْ فِيهِ خِيرَةْ.

114
00:08:22,866 --> 00:08:28,523
وَبَعْدَ نَحْوِ ثَلَاثِ سِنِينَ، كَانَتْ مُؤْتَةُ. أَخَذَ الرَّايَةَ زَيْدٌ فَأُصِيبَ،

115
00:08:28,809 --> 00:08:33,933
ثُمَّ أَخَذَهَا جَعْفَرٌ فَأُصِيبَ، ثُمَّ أَخَذَهَا ابْنُ رَوَاحَةَ فَأُصِيبَ،

116
00:08:34,219 --> 00:08:39,114
ثُمَّ أَخَذَهَا خَالِدُ بْنُ الْوَلِيدِ مِنْ غَيْرِ إِمْرَةٍ، فَفُتِحَ لَهُ.

117
00:08:39,400 --> 00:08:44,428
وَالنَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ فِي الْمَدِينَةِ يَنْعَاهُمْ

118
00:08:44,714 --> 00:08:48,238
لِلنَّاسِ وَعَيْنَاهُ تَذْرِفَانِ، ثُمَّ قَالَ:

119
00:08:48,523 --> 00:08:55,152
… حَتَّى أَخَذَ الرَّايَةَ سَيْفٌ مِنْ سُيُوفِ اللَّهِ، حَتَّى فَتَحَ اللَّهُ عَلَيْهِمْ.

120
00:08:55,438 --> 00:08:58,476
وَيَقُولُ خَالِدٌ عَنْ ذَلِكَ الْيَوْمِ: لَقَدِ

121
00:08:58,761 --> 00:09:02,819
انْقَطَعَتْ فِي يَدِي يَوْمَ مُؤْتَةَ تِسْعَةُ أَسْيَافٍ،

122
00:09:03,104 --> 00:09:07,095
فَمَا بَقِيَ فِي يَدِي إِلَّا صَفِيحَةٌ يَمَانِيَةْ.

123
00:09:07,380 --> 00:09:13,438
وَكَانَتْ أَوَّلُ خُطْوَةٍ فِي الطَّرِيقِ كَلِمَةً مِنْ أَخِيهِ: اسْتَدْرِكْ مَا فَاتَكَ.

124
00:09:13,723 --> 00:09:19,466
مِنْ فَارِسٍ كَانَ مَعَ خَيْلِ الْمُشْرِكِينَ… إِلَى سَيْفٍ مِنْ سُيُوفِ اللَّهِ.
